PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=eduquest
DB_USER=root
DB_PASSWORD=

# Use a long random secret in every environment (32+ chars required in production).
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Production default is 1d if unset; development may use 7d.
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Required in production. Local Vite default:
CLIENT_URL=http://localhost:5173
UPLOAD_MAX_SIZE_MB=10

# SMTP / email (password reset). Use Mailhog, Ethereal, or any SMTP provider.
# Leave MAIL_HOST empty to disable outbound SMTP (forgot-password still returns the generic success response).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=EduWow <noreply@eduquest.local>
# Optional override (default 30 minutes):
# PASSWORD_RESET_TTL_MS=1800000

# Rate limits (safe defaults for thesis testing; tighten in production).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=120

# AI usage / cost protection (server-enforced; thesis-friendly defaults).
AI_DAILY_REQUEST_LIMIT=200
AI_HOURLY_REQUEST_LIMIT=100
AI_MAX_QUESTIONS=15
AI_MAX_GAME_ITEMS=20
AI_MAX_INPUT_CHARACTERS=20000
AI_MAX_FILE_SIZE_MB=10
AI_MAX_PROMPT_CHARACTERS=6000
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=60000
AI_IDEMPOTENCY_WINDOW_MS=15000
